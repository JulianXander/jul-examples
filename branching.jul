# Branching
# 1.1 primitiver Wert wird auto wrapped zum 1. Argument
myFunction2 = (a) => log(a)
myFunction2(1)
# äquivalent
1 ?
	myFunction2

# 1.2 Type Parametered Functions bekommen den rohen Wert
1 ?
	# dieser branch greift
	1 => log(1)
	# dieser branch würde greifen, wenn er vorne steht
	(a: 1) => log(§a: 1§)

# 2.1 Collection Wert wird auto spreaded
[1] ?
	# dieser branch greift nicht: Parameter Type bekommt (1), erwartet 1
	1 => log(1)
	# dieser branch greift: a bekommt 1
	(a: 1) => log(§a: 1§)
	# dieser branch greift nicht
	(a: [1]) => log(§a: (1)§)

# 2.2 Collection Wert wird auto spreaded
myFunction3 = (args: List(Any)) => log(...args)
myFunction3([1 2])
# nicht äquivalent, args bekommt 1
[1 2] ?
	myFunction3

# 2.4
MyType = [1 2]
myFunction = (a b) => log(a b)
[1 2] ?
	# dieser branch greift
	MyType => log(§MyType§)
	# würde greifen
	(a: 1 b: 2) => myFunction(a b)
	# greift nicht, a bekommt 1
	(a: MyType) => log(...a)
	# würde greifen, rest bekommt (1, 2)
	(...rest: MyType) => log(...rest)
	# würde greifen, a bekommt 1, b bekommt 2
	myFunction

# 3. TODO multi level destructuring in Parameterliste?
[1 [2 3]] ?
	(
		a: 1
		(
			b: 2
			c: 3
		)
	) => myFunction(a b)