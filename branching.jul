# Branching
# 1.
myFunction2 = (a) => log(a)
myFunction2(1)
# äquivalent
1 ?
	myFunction2

# 2.
1 ?
	# dieser branch greift
	1 => log(1)
	# dieser branch würde greifen, wenn er vorne steht
	(a: 1) => log(§a: 1§)

# nicht äquivalent
(1) ?
	# dieser branch greift nicht: geprüft wird die Liste (1), nicht 1
	1 => log(1)
	# dieser branch greift nicht: a bekommt (1), nicht 1
	(a: 1) => log(§a: 1§)
	# dieser branch greift
	(a: (1)) => log(§a: (1)§)

# 3.
myFunction3 = (args: List(Any)) => log(...args)
myFunction3((1 2))
# äquivalent
(1 2) ?
	myFunction3

# 4.
MyType = (
	a: 1
	b: 2
)
myFunction = (a b) => log(a b)
(1 2) ?
	# dieser branch greift
	MyType => log(§MyType§)
	# würde greifen, wenn vorne
	(
		a: (
			a: 1
			b: 2
		)
	) => myFunction(...a)
	# greift nicht
	(a: 1 b: 2) => log(a b)
	# greift, rest bekommt (1, 2)
	(...rest: MyType) => log(...rest)
	# würde greifen, a bekommt (1 2), b bekommt ()
	myFunction