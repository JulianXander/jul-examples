timer1$ = interval$(500f)
progress$ = timer1$.map$((value) => value.multiply(2))
progress$.subscribe(
	(value) =>
		endReached = value.greaterInteger(100)
		?(endReached)
			[true] =>
				timer1$.complete()
			[false] =>
				moveJs = ?(value.greaterInteger(2))
					[true] => §process.stdout.moveCursor(0, -2);§
					[false] => []
				runJs(
					§
						§(moveJs)
						# vorherigen Text löschen, falls weniger neu geschrieben wird
						# process.stdout.clearScreenDown();
						process.stdout.write('§(value.multiply(2))%\n');
						process.stdout.write('§(value)%\n');
					§
				)
)