(
	integersOf
	allOf
	firstIntegerOf
	lastIntegerOf
) = import(§./filter.jul§)

mixedValues = [
	1
	§zwei§
	3
	§vier§
]

test(
	§filter mit Narrowing§
	() =>
		integersOf(mixedValues).deepEqual([1 3])
)

test(
	§filter ohne Narrowing§
	() =>
		allOf(mixedValues).deepEqual([1 §zwei§ 3 §vier§])
)

test(
	§findFirst mit Narrowing§
	() =>
		firstIntegerOf(mixedValues).equal(1)
)

test(
	§findLast mit Narrowing§
	() =>
		lastIntegerOf(mixedValues).equal(3)
)
