(
	integersOf
	allOf
	firstIntegerOf
	lastIntegerOf
) = import(§./filter.jul§)

mixedValues = [
	1
	§zwei§
	3
	§vier§
]

test(
	§filter mit Narrowing§
	() =>
		assert(§nur die Integer§ integersOf(mixedValues).deepEqual([1 3]))
)

test(
	§filter ohne Narrowing§
	() =>
		assert(§alle Werte§ allOf(mixedValues).deepEqual([1 §zwei§ 3 §vier§]))
)

test(
	§findFirst mit Narrowing§
	() =>
		assert(§erster Integer§ firstIntegerOf(mixedValues).equal(1))
)

test(
	§findLast mit Narrowing§
	() =>
		assert(§letzter Integer§ lastIntegerOf(mixedValues).equal(3))
)
