(
	elementOrEmpty
	elementOrZero
	elementOrZeroAnyIndex
	elementOrZeroByCount
	elementOrZeroByPattern
) = import(§./get-element.jul§)

values = [
	10
	20
	30
]

test(
	§ohne Prüfung Empty hinter dem Ende§
	() =>
		assert(§Index 4 ist Empty§ elementOrEmpty(values 4).equal())
)

test(
	§Bedingung innerhalb der Länge§
	() =>
		assert(§letztes Element§ elementOrZero(values 3).equal(30))
)

test(
	§Bedingung hinter dem Ende§
	() =>
		assert(§Index 4 ist 0§ elementOrZero(values 4).equal(0))
)

test(
	§Bedingung mit beiden Grenzen§
	() =>
		assert(§erstes Element§ elementOrZeroAnyIndex(values 1).equal(10))
		assert(§Index 0 ist 0§ elementOrZeroAnyIndex(values 0).equal(0))
		assert(§Index 4 ist 0§ elementOrZeroAnyIndex(values 4).equal(0))
)

test(
	§Bedingung über einen Namen§
	() =>
		assert(§zweites Element§ elementOrZeroByCount(values 2).equal(20))
		assert(§Index 4 ist 0§ elementOrZeroByCount(values 4).equal(0))
)

test(
	§Typmuster§
	() =>
		assert(§zweites Element§ elementOrZeroByPattern(values 2).equal(20))
		assert(§Index 4 ist 0§ elementOrZeroByPattern(values 4).equal(0))
)
