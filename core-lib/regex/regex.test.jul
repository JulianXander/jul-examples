(
	beforeHash
	date
	noMatch
	dateMultiline
	dateWithSeparator
) = import(§./regex.jul§)

test(
	§text before hash§
	() =>
		assert(§Text vor jedem #§ beforeHash.deepEqual([§abc § §abc §]))
)

test(
	§named captures§
	() =>
		assert(§Jahr, Monat und Tag§ date.deepEqual([year = §2026§ month = §10§ day = §10§]))
)

test(
	§no match§
	() =>
		assert(§kein Treffer ist false§ noMatch.equal(false))
)

test(
	§multiline regex§
	() =>
		assert(§Jahr, Monat und Tag§ dateMultiline.deepEqual([year = §2026§ month = §10§ day = §10§]))
)

test(
	§multiline regex with interpolation§
	() =>
		assert(§Treffer und Gruppen§ dateWithSeparator.deepEqual([§2026-10-10§ §2026§ §10§ §10§]))
)
