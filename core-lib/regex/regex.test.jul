(
	beforeHash
	date
	noMatch
	dateMultiline
	dateWithSeparator
) = import(§./regex.jul§)

test(
	§text before hash§
	() =>
		beforeHash.deepEqual([§abc § §abc §])
)

test(
	§named captures§
	() =>
		date.deepEqual([year = §2026§ month = §10§ day = §10§])
)

test(
	§no match§
	() =>
		noMatch.equal(false)
)

test(
	§multiline regex§
	() =>
		dateMultiline.deepEqual([year = §2026§ month = §10§ day = §10§])
)

test(
	§multiline regex with interpolation§
	() =>
		dateWithSeparator.deepEqual([§2026-10-10§ §2026§ §10§ §10§])
)
