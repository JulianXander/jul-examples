check1 = (value: Integer) =>
	value.greater(1)

check2 = (value: Integer) =>
	?(value)
		[GreaterInteger(1)] => true
		() => false

#TODO ? do1 narrowed nicht
do1 = (arr: List(Integer)) =>
	filtered1 = arr.filter(check1)
# do2 narrowed auf List(GreaterInteger(1))
do2 = (arr: List(Integer)) =>
	filtered2 = arr.filter(check2)