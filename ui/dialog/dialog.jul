(
	appendHtml
	elementById
	findElement
	onClick
	onDialogClose
	removeElement
	setText
	showModal
) = import(§./dom.ts§)

# Setzt den Text des Elements, bei einem Stream mit jedem neuen Wert, bis until$ einen neuen Wert
# liefert. Der übergebene Stream bleibt unberührt.
bindText = (
	element
	text: Or(Text Stream(Text))
	until$: Stream(Any)
) =>
	?(text)
		(fixedText: Text) => element.setText(fixedText)
		(textStream: Stream(Text)) =>
			textStream.takeUntil$(until$).subscribe(
				(value) => element.setText(value)
			)

# Öffnet einen modalen Bestätigungsdialog.
# title und question können fest oder ein Stream sein, der den Text laufend aktualisiert.
# Startwert: []
# Danach §ok§ oder §cancel§, auch Escape zählt als §cancel§.
confirm$ = (
	title: Or(Text Stream(Text))
	question: Or(Text Stream(Text))
) =>
	result$ = create$(Or([] §ok§ §cancel§) [])
	dialog = appendHtml(
		§html
			<dialog>
				<form method="dialog">
					<h2></h2>
					<p></p>
					<button value="ok" autofocus>OK</button>
					<button value="cancel">Abbrechen</button>
				</form>
			</dialog>
		§
	)
	# Die Bindungen enden, sobald result$ die Antwort liefert.
	bindText(dialog.findElement(§h2§) title result$)
	bindText(dialog.findElement(§p§) question result$)
	dialog.onDialogClose(
		(returnValue) =>
			dialog.removeElement()
			answer = ?(returnValue)
				[§ok§] => §ok§
				() => §cancel§
			result$.push(answer)
			result$.complete()
	)
	dialog.showModal()
	result$

elementById(§delete§).onClick(
	() =>
		seconds$ = timer$(1000f)
		result$ = confirm$(
			§Löschen§
			seconds$.map$(
				(value) => §Wirklich löschen? Seit dem Öffnen vergangen: §(value) s§
			)
		)
		result$.subscribe(
			(value) =>
				?(value)
					(answer: Or(§ok§ §cancel§)) =>
						# Der Timer gehört dem Aufrufer, also beendet ihn auch der Aufrufer, sobald der Dialog zu ist.
						# Das completed auch den daraus abgeleiteten Text-Stream.
						seconds$.complete()
						message = ?(answer)
							[§ok§] => §gelöscht§
							[§cancel§] => §abgebrochen§
						elementById(§log§).setText(message)
					() => []
		)
)

