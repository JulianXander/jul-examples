(
	appendHtml
	elementById
	findElement
	onClick
	onDialogClose
	removeElement
	setText
	showModal
) = import(§./dom.ts§)

# Setzt den Text des Elements, bei einem Stream mit jedem neuen Wert.
# Liefert die Bindung als Stream: complete darauf löst sie, der übergebene Stream bleibt unberührt.
bindText$ = (
	element
	text: Or(Text Stream(Text))
) =>
	text$ = ?(text)
		(fixedText: Text) => completed$(fixedText)
		(textStream: Stream(Text)) => textStream
	text$.map$(
		(value) => element.setText(value)
	)

# Öffnet einen modalen Bestätigungsdialog.
# title und question können fest oder ein Stream sein, der den Text laufend aktualisiert.
# Startwert: []
# Danach §ok§ oder §cancel§, auch Escape zählt als §cancel§.
confirm$ = (
	title: Or(Text Stream(Text))
	question: Or(Text Stream(Text))
) =>
	result$ = create$(Or([] §ok§ §cancel§) [])
	dialog = appendHtml(
		§html
			<dialog>
				<form method="dialog">
					<h2></h2>
					<p></p>
					<button value="ok" autofocus>OK</button>
					<button value="cancel">Abbrechen</button>
				</form>
			</dialog>
		§
	)
	titleBinding$ = bindText$(dialog.findElement(§h2§) title)
	questionBinding$ = bindText$(dialog.findElement(§p§) question)
	dialog.onDialogClose(
		(returnValue) =>
			titleBinding$.complete()
			questionBinding$.complete()
			dialog.removeElement()
			answer = ?(returnValue)
				[§ok§] => §ok§
				() => §cancel§
			result$.push(answer)
			result$.complete()
	)
	dialog.showModal()
	result$

elementById(§delete§).onClick(
	() =>
		seconds$ = timer$(1000f)
		result$ = confirm$(
			§Löschen§
			seconds$.map$(
				(value) => §Wirklich löschen? Seit dem Öffnen vergangen: §(value) s§
			)
		)
		result$.subscribe(
			(value) =>
				?(value)
					(answer: Or(§ok§ §cancel§)) =>
						# Der Timer gehört dem Aufrufer, also beendet ihn auch der Aufrufer, sobald der Dialog zu ist.
						# Das completed auch den daraus abgeleiteten Text-Stream.
						seconds$.complete()
						message = ?(answer)
							[§ok§] => §gelöscht§
							[§cancel§] => §abgebrochen§
						elementById(§log§).setText(message)
					() => []
		)
)

