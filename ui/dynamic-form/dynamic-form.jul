(
	elementById
	integerValue
	isChecked
	onInput
	setHidden
	setText
	textValue
) = import(§./dom.ts§)

# Der Wert, den read aus dem Eingabefeld liest, als Stream, der bei jeder Eingabe neu gelesen wird.
# Startwert: der Wert beim Aufruf.
inputValue$ = (
	element
	read: (input: Any) :> Any
) =>
	value$ = create$(TypeOf(read)/ReturnType element.read())
	element.onInput(() => value$.push(element.read()))
	value$

ageField = elementById(§age-field§)
output = elementById(§output§)
#ignore JUL2800
name$ = inputValue$(elementById(§name§) textValue)
#ignore JUL2800
age$ = inputValue$(elementById(§age§) integerValue)
#ignore JUL2800
ageVisible$ = inputValue$(elementById(§age-visible§) isChecked)

ageVisible$.subscribe(
	(value) => ageField.setHidden(not(value))
)

# Ein verstecktes Feld zählt nicht zu den Formulardaten.
data$ = combine$(name$ age$ ageVisible$).map$(
	(value) =>
		(name age ageVisible) = value
		[
			name = name
			age = ?(ageVisible)
				[true] => age
				() => []
		]
)
data$.subscribe(
	(value) => output.setText(toJson(value))
)

