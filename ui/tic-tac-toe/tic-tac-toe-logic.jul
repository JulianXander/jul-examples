Player = Or(§x§ §o§)
Cell = Or(§§ Player)
GameBoard = [
	[Cell Cell Cell]
	[Cell Cell Cell]
	[Cell Cell Cell]
]
GameStatus = Or(§running§ §tie§ §win§)
# Bei status §win§ ist currentPlayer der Gewinner.
GameState = [
	gameBoard: GameBoard
	currentPlayer: Player
	status: GameStatus
]

allEqual = (values: List(Any) expected) -> Boolean =>
	values.all((value) => value.equal(expected))

isTied = (gameBoard: GameBoard) -> Boolean =>
	gameBoard.all((row = value) => row.all((cell = value) => not(cell.equal(§§))))

checkWinner = (
	gameBoard: GameBoard
	player: Player
	rowIndex: Or(1 2 3)
	columnIndex: Or(1 2 3)
) -> Boolean =>
	row = gameBoard.getElement(rowIndex)
	column = range(1 3).map((value) => gameBoard.getElement(value).getElement(columnIndex))
	topLeftDiagonal = [
		gameBoard.getElement(1).getElement(1)
		gameBoard.getElement(2).getElement(2)
		gameBoard.getElement(3).getElement(3)
	]
	bottomLeftDiagonal = [
		gameBoard.getElement(3).getElement(1)
		gameBoard.getElement(2).getElement(2)
		gameBoard.getElement(1).getElement(3)
	]
	isWinner = or(
		allEqual(row player)
		allEqual(column player)
		allEqual(topLeftDiagonal player)
		allEqual(bottomLeftDiagonal player)
	)

# Setzt currentPlayer auf das Feld und liefert den neuen Spielzustand.
# Nur bei status §running§ wechselt der Spieler, sonst bleibt er stehen.
applyMove = (
	gameState: GameState
	rowIndex: Or(1 2 3)
	columnIndex: Or(1 2 3)
) -> GameState =>
	currentPlayer = gameState/currentPlayer
	currentRow = gameState/gameBoard.getElement(rowIndex)
	newRow = currentRow.setElement(columnIndex currentPlayer)
	newGameBoard = gameState/gameBoard.setElement(rowIndex newRow)
	isWinner = checkWinner(newGameBoard currentPlayer rowIndex columnIndex)
	status: GameStatus = ?(isWinner)
		[true] => §win§
		[false] =>
			tie = isTied(newGameBoard)
			?(tie)
				[true] => §tie§
				[false] => §running§
	[
		gameBoard = newGameBoard
		currentPlayer = ?(status)
			[§running§] =>
				?(currentPlayer)
					[§x§] => §o§
					[§o§] => §x§
			[§win§] => currentPlayer
			[§tie§] => currentPlayer
		status = status
	]
