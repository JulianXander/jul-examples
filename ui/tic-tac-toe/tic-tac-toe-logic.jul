Player = Or(§x§ §o§)
Cell = Or(§§ Player)
GameBoard = [
	[Cell Cell Cell]
	[Cell Cell Cell]
	[Cell Cell Cell]
]
GameStatus = Or(§running§ §tie§ §win§)
# Bei status §win§ ist currentPlayer der Gewinner.
GameState = [
	gameBoard: GameBoard
	currentPlayer: Player
	status: GameStatus
]
CellChange = [
	rowIndex: Or(1 2 3)
	columnIndex: Or(1 2 3)
	value: Cell
	enabled: Boolean
]
StatusChange = [
	currentPlayer: Player
	status: GameStatus
]
# Änderung am GameState: die geänderten Zellen und, falls sie sich ändern, die neuen Werte von
# currentPlayer und status.
# enabled gehört nicht zum GameState: Eine Zelle ist aktiv, wenn sie leer ist und status §running§ ist.
# Das Delta nennt die Zellen, deren Wert oder Aktivierung sich dadurch ändert.
GameStateChange = [
	cellChanges: Or([] List(CellChange))
	stateChange: Or([] StatusChange)
]

allEqual = (values: List(Any) expected) -> Boolean =>
	values.all((value) => value.equal(expected))

isTied = (gameBoard: GameBoard) -> Boolean =>
	gameBoard.all((row = value) => row.all((cell = value) => not(cell.equal(§§))))

checkWinner = (
	gameBoard: GameBoard
	player: Player
	rowIndex: Or(1 2 3)
	columnIndex: Or(1 2 3)
) -> Boolean =>
	row = gameBoard.getElement(rowIndex)
	column = range(1 3).map((value) => gameBoard.getElement(value).getElement(columnIndex))
	topLeftDiagonal = [
		gameBoard.getElement(1).getElement(1)
		gameBoard.getElement(2).getElement(2)
		gameBoard.getElement(3).getElement(3)
	]
	bottomLeftDiagonal = [
		gameBoard.getElement(3).getElement(1)
		gameBoard.getElement(2).getElement(2)
		gameBoard.getElement(1).getElement(3)
	]
	isWinner = or(
		allEqual(row player)
		allEqual(column player)
		allEqual(topLeftDiagonal player)
		allEqual(bottomLeftDiagonal player)
	)

# Berechnet die Änderung, die ein Zug am GameState bewirkt.
# Nur bei status §running§ wechselt der Spieler, bei §win§ ist currentPlayer der Gewinner.
# Liefert alle Zellen des Bretts mit ihrer Position.
cellsOf = (gameBoard: GameBoard) =>
	cellsByRow = range(1 3).map(
		(rowIndex = value) => range(1 3).map(
			(columnIndex = value) => [
				rowIndex = rowIndex
				columnIndex = columnIndex
				value = gameBoard.getElement(rowIndex).getElement(columnIndex)
			]
		)
	)
	cellsByRow.flatten()

computeMoveDelta = (
	gameState: GameState
	rowIndex: Or(1 2 3)
	columnIndex: Or(1 2 3)
) -> GameStateChange =>
	currentPlayer = gameState/currentPlayer
	currentRow = gameState/gameBoard.getElement(rowIndex)
	newRow = currentRow.setElement(columnIndex currentPlayer)
	newGameBoard = gameState/gameBoard.setElement(rowIndex newRow)
	isWinner = checkWinner(newGameBoard currentPlayer rowIndex columnIndex)
	status: GameStatus = ?(isWinner)
		[true] => §win§
		[false] =>
			tie = isTied(newGameBoard)
			?(tie)
				[true] => §tie§
				[false] => §running§
	clickedChange = [rowIndex = rowIndex columnIndex = columnIndex value = currentPlayer enabled = false]
	# nach Spielende werden die übrigen leeren Zellen deaktiviert
	emptyCells = cellsOf(newGameBoard).filter((cell = value) => cell/value.equal(§§))
	disabledChanges = emptyCells.map(
		(cell = value) => [rowIndex = cell/rowIndex columnIndex = cell/columnIndex value = §§ enabled = false]
	)
	[
		cellChanges = ?(status)
			[§running§] => [clickedChange]
			[§win§] => flatten([[clickedChange] disabledChanges])
			[§tie§] => flatten([[clickedChange] disabledChanges])
		stateChange = [
			currentPlayer = ?(status)
				[§running§] =>
					?(currentPlayer)
						[§x§] => §o§
						[§o§] => §x§
				[§win§] => currentPlayer
				[§tie§] => currentPlayer
			status = status
		]
	]

# Ein Reset leert die belegten Zellen. Nach einem Spielende werden auch die leeren wieder aktiviert.
# Spieler und Status ändern sich nur, wenn das Spiel nicht schon im Anfangszustand ist.
computeResetDelta = (gameState: GameState) -> GameStateChange =>
	isRunning = gameState/status.equal(§running§)
	changedCells = cellsOf(gameState/gameBoard).filter(
		(cell = value) => or(not(cell/value.equal(§§)) not(isRunning))
	)
	cellChanges = changedCells.map(
		(cell = value) => [rowIndex = cell/rowIndex columnIndex = cell/columnIndex value = §§ enabled = true]
	)
	isInitialPlayer = gameState/currentPlayer.equal(§x§)
	stateChange = ?(and(isRunning isInitialPlayer))
		[true] => []
		[false] => [currentPlayer = §x§ status = §running§]
	[
		cellChanges = cellChanges
		stateChange = stateChange
	]

applyDelta = (gameState: GameState delta: GameStateChange) -> GameState =>
	newGameBoard = delta/cellChanges.aggregate(
		GameBoard
		gameState/gameBoard
		(gameBoard = accumulator cellChange = value) =>
			row = gameBoard.getElement(cellChange/rowIndex)
			newRow = row.setElement(cellChange/columnIndex cellChange/value)
			gameBoard.setElement(cellChange/rowIndex newRow)
	)
	?(delta/stateChange)
		(stateChange: StatusChange) =>
			[
				gameBoard = newGameBoard
				currentPlayer = stateChange/currentPlayer
				status = stateChange/status
			]
		() =>
			[
				gameBoard = newGameBoard
				currentPlayer = gameState/currentPlayer
				status = gameState/status
			]
