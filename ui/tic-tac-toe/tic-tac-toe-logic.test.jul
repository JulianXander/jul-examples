(allEqual checkWinner isTied) = import(§./tic-tac-toe-logic.jul§)

test(
	§allEqual-positive§
	() => allEqual([§x§ §x§ §x§] §x§)
)

test(
	§allEqual-negative§
	() => not(allEqual([§x§ §o§ §x§] §x§))
)

test(
	§isTied§
	() =>
		isTied([
			[§x§ §x§ §x§]
			[§x§ §x§ §x§]
			[§x§ §x§ §x§]
		])
)

test(
	§checkWinner§
	() =>
		not(checkWinner(
			[
				[§x§ §§ §x§]
				[§x§ §§ §§]
				[§x§ §x§ §x§]
			]
			§x§
			1
			3
		))
)