(allEqual applyDelta checkWinner computeMoveDelta computeResetDelta isTied) = import(§./tic-tac-toe-logic.jul§)

test(
	§allEqual-positive§
	() => allEqual([§x§ §x§ §x§] §x§)
)

test(
	§allEqual-negative§
	() => not(allEqual([§x§ §o§ §x§] §x§))
)

test(
	§isTied§
	() =>
		isTied([
			[§x§ §x§ §x§]
			[§x§ §x§ §x§]
			[§x§ §x§ §x§]
		])
)

test(
	§checkWinner§
	() =>
		not(checkWinner(
			[
				[§x§ §§ §x§]
				[§x§ §§ §§]
				[§x§ §x§ §x§]
			]
			§x§
			1
			3
		))
)

test(
	§computeMoveDelta-running-switches-player§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§§ §§ §§]
					[§§ §§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			1
			1
		)
		and(
			delta/stateChange/status.equal(§running§)
			delta/stateChange/currentPlayer.equal(§o§)
		)
)

test(
	§computeMoveDelta-win-keeps-winner§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§x§ §x§ §§]
					[§o§ §o§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			1
			3
		)
		and(
			delta/stateChange/status.equal(§win§)
			delta/stateChange/currentPlayer.equal(§x§)
		)
)

test(
	§computeMoveDelta-tie§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§x§ §o§ §x§]
					[§x§ §o§ §o§]
					[§o§ §x§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			3
			3
		)
		delta/stateChange/status.equal(§tie§)
)

test(
	§computeMoveDelta-changes-only-the-clicked-cell§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§§ §§ §§]
					[§§ §§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			2
			3
		)
		delta/cellChanges.deepEqual([[rowIndex = 2 columnIndex = 3 value = §x§ enabled = false]])
)

test(
	§applyDelta-applies-cell-changes§
	() =>
		newState = applyDelta(
			[
				gameBoard = [
					[§§ §§ §§]
					[§§ §§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			[
				cellChanges = [[rowIndex = 2 columnIndex = 3 value = §x§ enabled = false]]
				stateChange = [currentPlayer = §o§ status = §running§]
			]
		)
		newState.deepEqual([
			gameBoard = [
				[§§ §§ §§]
				[§§ §§ §x§]
				[§§ §§ §§]
			]
			currentPlayer = §o§
			status = §running§
		])
)

test(
	§computeResetDelta-clears-only-filled-cells§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§x§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §o§]
			]
			currentPlayer = §x§
			status = §running§
		])
		delta.deepEqual([
			cellChanges = [
				[rowIndex = 1 columnIndex = 1 value = §§ enabled = true]
				[rowIndex = 3 columnIndex = 3 value = §§ enabled = true]
			]
			stateChange = []
		])
)

test(
	§computeResetDelta-empty-board-has-no-changes§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §x§
			status = §running§
		])
		delta/cellChanges.deepEqual([])
)

test(
	§computeMoveDelta-win-disables-empty-cells§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§x§ §x§ §§]
					[§o§ §o§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			1
			3
		)
		delta/cellChanges.deepEqual([
			[rowIndex = 1 columnIndex = 3 value = §x§ enabled = false]
			[rowIndex = 2 columnIndex = 3 enabled = false]
			[rowIndex = 3 columnIndex = 1 enabled = false]
			[rowIndex = 3 columnIndex = 2 enabled = false]
			[rowIndex = 3 columnIndex = 3 enabled = false]
		])
)

test(
	§computeResetDelta-after-game-over-only-enables-empty-cells§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§x§ §x§ §x§]
				[§o§ §o§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §x§
			status = §win§
		])
		delta/cellChanges.deepEqual([
			[rowIndex = 1 columnIndex = 1 value = §§ enabled = true]
			[rowIndex = 1 columnIndex = 2 value = §§ enabled = true]
			[rowIndex = 1 columnIndex = 3 value = §§ enabled = true]
			[rowIndex = 2 columnIndex = 1 value = §§ enabled = true]
			[rowIndex = 2 columnIndex = 2 value = §§ enabled = true]
			[rowIndex = 2 columnIndex = 3 enabled = true]
			[rowIndex = 3 columnIndex = 1 enabled = true]
			[rowIndex = 3 columnIndex = 2 enabled = true]
			[rowIndex = 3 columnIndex = 3 enabled = true]
		])
)

test(
	§computeResetDelta-initial-state-has-no-state-change§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §x§
			status = §running§
		])
		delta/stateChange.deepEqual([])
)

test(
	§computeResetDelta-after-move-resets-player§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§x§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §o§
			status = §running§
		])
		delta/stateChange.deepEqual([currentPlayer = §x§ status = §running§])
)

test(
	§applyDelta-without-state-change-keeps-player-and-status§
	() =>
		newState = applyDelta(
			[
				gameBoard = [
					[§§ §§ §§]
					[§§ §§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §o§
				status = §running§
			]
			[
				cellChanges = []
				stateChange = []
			]
		)
		and(
			newState/currentPlayer.equal(§o§)
			newState/status.equal(§running§)
		)
)

test(
	§applyDelta-enabled-only-change-keeps-board§
	() =>
		gameState = [
			gameBoard = [
				[§x§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §o§
			status = §win§
		]
		newState = applyDelta(
			gameState
			[
				cellChanges = [[rowIndex = 2 columnIndex = 2 enabled = false]]
				stateChange = []
			]
		)
		newState.deepEqual(gameState)
)
