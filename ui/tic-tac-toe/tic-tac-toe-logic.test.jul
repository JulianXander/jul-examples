(
	allEqual
	applyDelta
	checkWinner
	computeMoveDelta
	computeResetDelta
	hasFreeCell
	isBoardEmpty
) = import(§./tic-tac-toe-logic.jul§)

test(
	§allEqual-positive§
	() => assert(§drei gleiche§ allEqual([§x§ §x§ §x§] §x§))
)

test(
	§allEqual-negative§
	() => assert(§ein anderer dazwischen§ not(allEqual([§x§ §o§ §x§] §x§)))
)

test(
	§hasFreeCell§
	() =>
		assert(
			§eine leere Zelle unten rechts§
			hasFreeCell([
				[§x§ §x§ §x§]
				[§x§ §x§ §x§]
				[§x§ §x§ §§]
			])
		)
)

test(
	§checkWinner§
	() =>
		assert(
			§kein Sieg durch Zug in Zeile 1, Spalte 3§
			not(checkWinner(
				[
					[§x§ §§ §x§]
					[§x§ §§ §§]
					[§x§ §x§ §x§]
				]
				§x§
				1
				3
			))
		)
)

test(
	§computeMoveDelta-running-switches-player§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§§ §§ §§]
					[§§ §§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			1
			1
		)
		assert(§Spiel läuft weiter§ delta/status.equal(§running§))
		assert(§o ist am Zug§ delta/currentPlayer.equal(§o§))
)

test(
	§computeMoveDelta-win-keeps-winner§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§x§ §x§ §§]
					[§o§ §o§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			1
			3
		)
		assert(§x hat gewonnen§ delta/status.equal(§win§))
		assert(§Gewinner bleibt am Zug§ delta/currentPlayer.equal(§x§))
)

test(
	§computeMoveDelta-tie§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§x§ §o§ §x§]
					[§x§ §o§ §o§]
					[§o§ §x§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			3
			3
		)
		assert(§unentschieden§ delta/status.equal(§tie§))
)

test(
	§computeMoveDelta-changes-only-the-clicked-cell§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§§ §§ §§]
					[§§ §§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			2
			3
		)
		assert(§nur Zeile 2, Spalte 3§ delta/cellChanges.deepEqual([[rowIndex = 2 columnIndex = 3 value = §x§ enabled = false]]))
)

test(
	§applyDelta-applies-cell-changes§
	() =>
		newState = applyDelta(
			[
				gameBoard = [
					[§§ §§ §§]
					[§§ §§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			[
				cellChanges = [[rowIndex = 2 columnIndex = 3 value = §x§ enabled = false]]
				currentPlayer = §o§
				status = §running§
			]
		)
		assert(
			§x in Zeile 2, Spalte 3, o am Zug§
			newState.deepEqual([
				gameBoard = [
					[§§ §§ §§]
					[§§ §§ §x§]
					[§§ §§ §§]
				]
				currentPlayer = §o§
				status = §running§
			])
		)
)

test(
	§computeResetDelta-clears-only-filled-cells§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§x§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §o§]
			]
			currentPlayer = §x§
			status = §running§
		])
		assert(
			§nur die gefüllten Zellen geleert§
			delta.deepEqual([
				cellChanges = [
					[rowIndex = 1 columnIndex = 1 value = §§ enabled = true]
					[rowIndex = 3 columnIndex = 3 value = §§ enabled = true]
				]
				currentPlayer = §x§
				status = §running§
			])
		)
)

test(
	§computeResetDelta-empty-board-has-no-changes§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §x§
			status = §running§
		])
		assert(§keine Änderungen§ delta/cellChanges.deepEqual([]))
)

test(
	§computeMoveDelta-win-disables-empty-cells§
	() =>
		delta = computeMoveDelta(
			[
				gameBoard = [
					[§x§ §x§ §§]
					[§o§ §o§ §§]
					[§§ §§ §§]
				]
				currentPlayer = §x§
				status = §running§
			]
			1
			3
		)
		assert(
			§Siegzug gesetzt, leere Zellen gesperrt§
			delta/cellChanges.deepEqual([
				[rowIndex = 1 columnIndex = 3 value = §x§ enabled = false]
				[rowIndex = 2 columnIndex = 3 enabled = false]
				[rowIndex = 3 columnIndex = 1 enabled = false]
				[rowIndex = 3 columnIndex = 2 enabled = false]
				[rowIndex = 3 columnIndex = 3 enabled = false]
			])
		)
)

test(
	§computeResetDelta-after-game-over-only-enables-empty-cells§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§x§ §x§ §x§]
				[§o§ §o§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §x§
			status = §win§
		])
		assert(
			§alle Zellen wieder frei, nur gefüllte geleert§
			delta/cellChanges.deepEqual([
				[rowIndex = 1 columnIndex = 1 value = §§ enabled = true]
				[rowIndex = 1 columnIndex = 2 value = §§ enabled = true]
				[rowIndex = 1 columnIndex = 3 value = §§ enabled = true]
				[rowIndex = 2 columnIndex = 1 value = §§ enabled = true]
				[rowIndex = 2 columnIndex = 2 value = §§ enabled = true]
				[rowIndex = 2 columnIndex = 3 enabled = true]
				[rowIndex = 3 columnIndex = 1 enabled = true]
				[rowIndex = 3 columnIndex = 2 enabled = true]
				[rowIndex = 3 columnIndex = 3 enabled = true]
			])
		)
)

test(
	§computeResetDelta-after-game-over-resets-player-and-status§
	() =>
		delta = computeResetDelta([
			gameBoard = [
				[§x§ §x§ §x§]
				[§o§ §o§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §x§
			status = §win§
		])
		assert(§x beginnt§ delta/currentPlayer.equal(§x§))
		assert(§Spiel läuft wieder§ delta/status.equal(§running§))
)

test(
	§applyDelta-enabled-only-change-keeps-board§
	() =>
		gameState = [
			gameBoard = [
				[§x§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §§]
			]
			currentPlayer = §o§
			status = §win§
		]
		newState = applyDelta(
			gameState
			[
				cellChanges = [[rowIndex = 2 columnIndex = 2 enabled = false]]
				currentPlayer = §o§
				status = §win§
			]
		)
		assert(§Brett unverändert§ newState.deepEqual(gameState))
)

test(
	§isBoardEmpty-positive§
	() =>
		assert(
			§leeres Brett§
			isBoardEmpty([
				[§§ §§ §§]
				[§§ §§ §§]
				[§§ §§ §§]
			])
		)
)

test(
	§isBoardEmpty-negative§
	() =>
		assert(
			§ein x in der Mitte§
			not(isBoardEmpty([
				[§§ §§ §§]
				[§§ §x§ §§]
				[§§ §§ §§]
			]))
		)
)
