(
	elementById
	setEnabled
	setText
	subscribeEvent
) = import(§./dom.ts§)
(
	checkWinner
	GameBoard
	GameState
	isTied
) = import(§./tic-tac-toe-logic.jul§)

#TODO support nativeFunction at runtime in userland
# subscribeEvent = nativeFunction(
# 	(listener) :> []
# 	§js
# 		document.addEventListener('click', listener);
# 	§
# )

initialGameState: GameState = [
	gameBoard = [
		[§§ §§ §§]
		[§§ §§ §§]
		[§§ §§ §§]
	]
	currentPlayer = §x§
]

walk = (
	gameBoard: GameBoard
	iteratee: (
		rowIndex: Or(1 2 3)
		columnIndex: Or(1 2 3)
		cellElement: Any
	) ~> Any
) =>
	gameBoard.forEach(
		(row = value rowIndex = index) => row.forEach(
			(cellValue = value columnIndex = index) =>
				cellElement = elementById(§§(rowIndex)-§(columnIndex)§)
				iteratee(rowIndex columnIndex cellElement)
		)
	)

#ignore JUL2800
gameState$ = create$(GameState initialGameState)

statusElement = elementById(§status§)

disableGameBoard = (gameBoard: GameBoard) =>
	walk(
		gameBoard
		(rowIndex columnIndex cellElement) =>
			cellElement.setEnabled(false)
	)

walk(
	initialGameState/gameBoard
	(rowIndex columnIndex cellElement) =>
		subscribeEvent(
			cellElement
			§click§
			() =>
				currentGameState = gameState$/getValue()

				# update ui
				setEnabled(cellElement false)
				setText(cellElement currentGameState/currentPlayer)

				# update state
				currentPlayer = currentGameState/currentPlayer
				currentRow = currentGameState/gameBoard.getElement(rowIndex)
				newRow = currentRow.setElement(columnIndex currentPlayer)
				newGameBoard = currentGameState/gameBoard.setElement(rowIndex newRow)
				newGameState: GameState = [
					gameBoard = newGameBoard
					currentPlayer = ?(currentPlayer)
						[§x§] => §o§
						[§o§] => §x§
				]
				gameState$.push(newGameState)

				isWinner = checkWinner(newGameBoard currentPlayer rowIndex columnIndex)
				?(isWinner)
					[true] =>
						disableGameBoard(newGameBoard)
						statusElement.setText(§Spieler §(currentPlayer) hat gewonnen§)
					[false] =>
						tie = isTied(newGameBoard)
						?(tie)
							[true] => statusElement.setText(§Unentschieden§)
							[false] => statusElement.setText(§Aktueller Spieler: §(newGameState/currentPlayer)§)
		)
)

resetElement = elementById(§reset§)
subscribeEvent(
	resetElement
	§click§
	() =>
		# reset ui
		walk(
			initialGameState/gameBoard
			(rowIndex columnIndex cellElement) =>
				setText(cellElement §§)
				setEnabled(cellElement true)
		)
		statusElement.setText(§Aktueller Spieler: x§)

		# reset state
		gameState$.push(initialGameState)
)