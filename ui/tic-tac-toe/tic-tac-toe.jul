(
	elementById
	setEnabled
	setText
	subscribeEvent
) = import(§./dom.ts§)
(
	applyDelta
	computeMoveDelta
	computeResetDelta
	GameStateChange
	GameState
	isBoardEmpty
) = import(§./tic-tac-toe-logic.jul§)

#TODO support nativeFunction at runtime in userland
# subscribeEvent = nativeFunction(
# 	(listener) :> []
# 	§js
# 		document.addEventListener('click', listener);
# 	§
# )

#region GameState
initialDelta: GameStateChange = [
	cellChanges = []
	currentPlayer = §x§
	status = §running§
]
#ignore JUL2800
delta$ = create$(GameStateChange initialDelta)

initialGameState: GameState = [
	gameBoard = [
		[§§ §§ §§]
		[§§ §§ §§]
		[§§ §§ §§]
	]
	currentPlayer = §x§
	status = §running§
]
#ignore JUL2800
gameState$ = create$(GameState initialGameState)

# state: wird nur aus den Deltas aufgebaut
delta$.subscribe(
	(delta = value) =>
		gameState$.push(applyDelta(gameState$/getValue() delta))
)
#endregion GameState

#region reactive ui updates
# Zellen: reagieren nur auf die Deltas
delta$.subscribe(
	(delta = value) =>
		delta/cellChanges.forEach(
			(cellChange = value) =>
				cellElement = elementById(§§(cellChange/rowIndex)-§(cellChange/columnIndex)§)
				?(cellChange/value)
					(newValue: Text) => setText(cellElement newValue)
					() => []
				?(cellChange/enabled)
					(enabled: Boolean) => setEnabled(cellElement enabled)
					() => []
		)
)

# status: wird aus dem State abgeleitet, ein gleichbleibender Text wird nicht neu geschrieben
statusElement = elementById(§status§)
statusText = (gameState: GameState) =>
	?(gameState/status)
		[§win§] => §Spieler §(gameState/currentPlayer) hat gewonnen§
		[§tie§] => §Unentschieden§
		[§running§] => §Aktueller Spieler: §(gameState/currentPlayer)§
statusText$ = map$(gameState$ (gameState = value) => statusText(gameState))
statusText$.subscribe(
	(text = value) => statusElement.setText(text)
)

# reset: nur aktiv, wenn es etwas zurückzusetzen gibt
resetElement = elementById(§reset§)
resetEnabled$ = map$(gameState$ (gameState = value) => not(isBoardEmpty(gameState/gameBoard)))
resetEnabled$.subscribe(
	(enabled = value) => resetElement.setEnabled(enabled)
)
#endregion reactive ui updates

#region register events
# registriere cell clicks
initialGameState/gameBoard.forEach(
	(row = value rowIndex = index) => row.forEach(
		(cellValue = value columnIndex = index) =>
			subscribeEvent(
				elementById(§§(rowIndex)-§(columnIndex)§)
				§click§
				() => delta$.push(computeMoveDelta(gameState$/getValue() rowIndex columnIndex))
			)
	)
)

subscribeEvent(
	resetElement
	§click§
	() => delta$.push(computeResetDelta(gameState$/getValue()))
)
#endregion register events