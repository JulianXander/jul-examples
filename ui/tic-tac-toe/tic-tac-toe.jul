(
	elementById
	setEnabled
	setText
	subscribeEvent
) = import(§./dom.ts§)
(checkWinner GameState) = import(§tic-tac-toe-logic.jul§)

#TODO support nativeFunction at runtime in userland
# subscribeEvent = nativeFunction(
# 	(listener) :> []
# 	§js
# 		document.addEventListener('click', listener);
# 	§
# )

test1 = () => log(§hello§)

initialGameState: GameState = [
	gameBoard = [
		[§§ §§ §§]
		[§§ §§ §§]
		[§§ §§ §§]
	]
	currentPlayer = §x§
]
#ignore JUL2800
gameState$ = create$(GameState initialGameState)

repeat(
	3
	(rowIndex = index) =>
		repeat(
			3
			(columnIndex = index) =>
				cellElement = elementById(§§(rowIndex)-§(columnIndex)§)
				subscribeEvent(
					cellElement
					§click§
					() =>
						currentGameState = gameState$/getValue()

						# update ui
						setEnabled(cellElement false)
						setText(cellElement currentGameState/currentPlayer)

						# update state
						currentPlayer = currentGameState/currentPlayer
						currentRow = currentGameState/gameBoard.getElement(rowIndex)
						newRow = currentRow.setElement(columnIndex currentPlayer)
						newGameState: GameState = [
							gameBoard = currentGameState/gameBoard.setElement(rowIndex newRow)
							currentPlayer = ?(currentPlayer)
								[§x§] => §o§
								[§o§] => §x§
						]
						gameState$.push(newGameState)

						isWinner = checkWinner(newGameState/gameBoard currentPlayer rowIndex columnIndex)
						?(isWinner)
							[true] =>
								log(§winner§ currentPlayer)
								# TOOD disable gameboard, show winner
				)
		)
)

resetElement = elementById(§reset§)
subscribeEvent(
	resetElement
	§click§
	() =>
		currentGameState = gameState$/getValue()

		# reset ui
		currentGameState/gameBoard.forEach(
			(row = value rowIndex = index) =>
				row.forEach(
					(column = value columnIndex = index) =>
						?(column)
							[Or(§x§ §o§)] =>
								cellElement = elementById(§§(rowIndex)-§(columnIndex)§)
								setText(cellElement §§)
								setEnabled(cellElement true)
				)
		)

		# reset state
		gameState$.push(initialGameState)
)