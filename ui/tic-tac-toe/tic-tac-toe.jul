(
	elementById
	setEnabled
	setText
	subscribeEvent
) = import(§./dom.ts§)
(
	applyDelta
	computeMoveDelta
	computeResetDelta
	Delta
	GameBoard
	GameState
	initialDelta
	StateChange
) = import(§./tic-tac-toe-logic.jul§)

#TODO support nativeFunction at runtime in userland
# subscribeEvent = nativeFunction(
# 	(listener) :> []
# 	§js
# 		document.addEventListener('click', listener);
# 	§
# )

initialGameState: GameState = [
	gameBoard = [
		[§§ §§ §§]
		[§§ §§ §§]
		[§§ §§ §§]
	]
	currentPlayer = §x§
	status = §running§
]

walk = (
	gameBoard: GameBoard
	iteratee: (
		rowIndex: Or(1 2 3)
		columnIndex: Or(1 2 3)
		cellElement: Any
	) ~> Any
) =>
	gameBoard.forEach(
		(row = value rowIndex = index) => row.forEach(
			(cellValue = value columnIndex = index) =>
				cellElement = elementById(§§(rowIndex)-§(columnIndex)§)
				iteratee(rowIndex columnIndex cellElement)
		)
	)

#ignore JUL2800
delta$ = create$(Delta initialDelta)
#ignore JUL2800
gameState$ = create$(GameState initialGameState)

# state: wird nur aus den Deltas aufgebaut
subscribe(
	delta$
	(delta = value) => gameState$.push(applyDelta(gameState$/getValue() delta))
)

statusElement = elementById(§status§)
# ui: reagiert nur auf die Deltas
subscribe(
	delta$
	(delta = value) =>
		delta/cellChanges.forEach(
			(cellChange = value) =>
				cellElement = elementById(§§(cellChange/rowIndex)-§(cellChange/columnIndex)§)
				setText(cellElement cellChange/value)
				setEnabled(cellElement cellChange/enabled)
		)
		?(delta/stateChange)
			(stateChange: StateChange) =>
				?(stateChange/status)
					[§win§] => statusElement.setText(§Spieler §(stateChange/currentPlayer) hat gewonnen§)
					[§tie§] => statusElement.setText(§Unentschieden§)
					[§running§] => statusElement.setText(§Aktueller Spieler: §(stateChange/currentPlayer)§)
			() => []
)

# registriere cell clicks
walk(
	initialGameState/gameBoard
	(rowIndex columnIndex cellElement) =>
		subscribeEvent(
			cellElement
			§click§
			() => delta$.push(computeMoveDelta(gameState$/getValue() rowIndex columnIndex))
		)
)

resetElement = elementById(§reset§)
subscribeEvent(
	resetElement
	§click§
	() => delta$.push(computeResetDelta(gameState$/getValue()))
)
